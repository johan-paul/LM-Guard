# Copy to .env (or export these directly) before running the AI service.
# The service works with NONE of these set: it degrades to OCR + regex extraction and
# reports that degradation in the response's `warnings`. It never crashes an inspection.

# Shared secret checked against the X-API-Key header the Spring Boot backend sends
# (matches AI_SERVICE_API_KEY on the Java side). Leave blank to disable auth for local dev.
AI_SERVICE_API_KEY=

# Enables the VLM semantic-extraction step (manufacturer name, commodity name, origin --
# fields a regex cannot reliably identify). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AI_ENABLE_VLM=true

# Image below this quality score (0..1) is reported as too poor to analyse rather than guessed.
AI_MIN_IMAGE_QUALITY=0.25

AI_IMAGE_FETCH_TIMEOUT_S=15
AI_VLM_TIMEOUT_S=30

      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Register an INSPECTOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Inspector\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"Str0ngPassw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.code === 201);",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"inspectorEmail\", pm.request.body ? JSON.parse(pm.request.body.raw).email : \"\");",
                  "pm.collectionVariables.set(\"inspectorToken\", body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Register an ADMIN",

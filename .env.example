# =====================================================================
# LM-GUARD backend - environment template
# ---------------------------------------------------------------------
# Copy this file to `.env`, fill in the values, and NEVER commit `.env`.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the SESSION POOLER (port 5432) or DIRECT connection for Flyway.
# Example:
#   DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   DB_USERNAME=postgres.abcdefghijklmnop
# ---------------------------------------------------------------------
DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=

# ---------------------------------------------------------------------
# SUPABASE API + STORAGE
# Supabase Dashboard -> Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY is a SECRET. Server-side only. Never ship to React.
# ---------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage provider: supabase | local
# `local` writes to ./storage-data and needs no Supabase account (offline demo).
STORAGE_PROVIDER=supabase

# Storage bucket names (create these in Supabase Storage)
STORAGE_BUCKET_PACKAGE_IMAGES=package-images
STORAGE_BUCKET_EVIDENCE=evidence
STORAGE_BUCKET_REPORTS=reports

# ---------------------------------------------------------------------
# SECURITY
# JWT_SECRET must be a Base64-encoded key of at least 256 bits (32 bytes).
# Generate one with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=lm-guard

# ---------------------------------------------------------------------
# AI / OCR SERVICE (external Python service, added later)
# AI_MOCK_MODE=true  -> backend runs the full pipeline with MockAIAnalysisService
# AI_FALLBACK_TO_MOCK=true -> if the real AI service errors, fall back to the
#                             mock so a live demo never dies mid-inspection.
# ---------------------------------------------------------------------
AI_MOCK_MODE=true
AI_FALLBACK_TO_MOCK=true
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_API_KEY=

# ---------------------------------------------------------------------
# CORS - React frontend origin(s), comma-separated. No wildcards in prod.
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------
# RULE ENGINE
# The ruleset version an inspection is evaluated against and recorded with.
# LM-PC-2011-v1 (default) is derived from the actual Legal Metrology (Packaged
# Commodities) Rules, 2011 -- see legal-rules/. Set to DEMO-2026.1 (with
# RULES_SAMPLE_FILE=classpath:rules/sample-rules.json) for the illustrative demo ruleset.
# ---------------------------------------------------------------------
RULES_ACTIVE_VERSION=LM-PC-2011-v1
RULES_SAMPLE_FILE=classpath:rules/lm-pc-2011-rules.json
RULES_SEED_DEMO=true
